{
  "name": "triptrace",
  "version": "0.1.0",
  "private": true,
  "description": "途迹 TripTrace —— 出差行程节点与里程的填报、建议与统计（Cloudflare Workers + D1 + KV）",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "types": "wrangler types",
    "check": "wrangler types && node scripts/check-version.mjs && tsc --noEmit",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply triptrace-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply triptrace-db --remote"
  },
  "devDependencies": {
    "typescript": "^5",
    "wrangler": "^4"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20261006.1": true
  }
}
