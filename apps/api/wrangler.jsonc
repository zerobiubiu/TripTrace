{
  "name": "triptrace",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-08",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "trips.zerobiubiu.top/api/*",
      "zone_name": "zerobiubiu.top"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "triptrace-db",
      "database_id": "52a9d143-2cb4-4888-b158-4dfb36adb6c4",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSIONS",
      "id": "aa2cda7e62da49c7bb8449ec6150d888"
    }
  ],
  "vars": {
    "APP_VERSION": "0.3.0",
    "PBKDF2_ITERATIONS": "100000",
    "WEB_APP_URL": "https://trips.zerobiubiu.top"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  }
}
