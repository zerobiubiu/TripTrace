{
  "name": "@triptrace/api",
  "private": true,
  "type": "module",
  "description": "途迹后端：Hono + Drizzle + D1/KV 的 Cloudflare Worker（只提供 /api/*）",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "deploy": "wrangler deploy",
    "types": "wrangler types --env-interface CloudflareBindings",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply triptrace-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply triptrace-db --remote"
  },
  "dependencies": {
    "@triptrace/contracts": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11"
  }
}
